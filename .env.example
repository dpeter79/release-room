# demo/setup.py writes .env for the demo. For a real app, copy this to .env (git-ignored). Never paste these into a room.
APP_STORE_KEY_ID=
APP_STORE_ISSUER_ID=
APP_STORE_P8_PATH=
# Set to a fake_asc.py state file to run without an Apple account.
ASC_MOCK=
# Optional, for @stats: a program that prints daily sales (docs/setup.md), and its config. The demo uses demo/fake_probe.py.
SALES_PROBE=
SALES_CONFIG=
# Console picks the local server port; the demo finds it for you.
SWITCH_API=http://127.0.0.1:65528
SWITCH_ASC_ID=
SWITCH_ASC_KEY=
